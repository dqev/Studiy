rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for role checking
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isTeacherOrAdmin() {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return userRole == 'teacher' || userRole == 'admin';
    }

    match /users/{userId} {
      // Allow unauthenticated users to query by username during signup
      allow list: if true; // Allow listing to check username availability
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if false;
      
      // Allow authenticated users to read specific fields including profile_picture
      match /{document=**} {
        allow read: if request.auth != null;
      }
    }
    
    match /materials/{materialId} {
      // Authenticated users can read all materials
      allow read: if request.auth != null;
      // Teachers and authenticated users can create materials
      allow create: if request.auth != null;
      // Teachers and admins can update their materials
      allow update: if request.auth != null && 
                       (request.auth.uid == resource.data.uploader_id || isAdmin());
      // Teachers and admins can delete their materials
      allow delete: if request.auth != null && 
                       (request.auth.uid == resource.data.uploader_id || isAdmin());
      
      // Allow subcollections for comments and likes
      match /comments/{document=**} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if request.auth != null;
      }
      
      match /likes/{document=**} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if request.auth != null;
      }
    }

    // Top-level comments collection (for admin queries)
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth.uid == resource.data.requester_id;
      
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        // Allow user to delete their own message
        allow delete: if request.auth.uid == resource.data.sender_id;
      }
    }

    match /lostAndFinder/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
                       (request.auth.uid == resource.data.uploaderId || 
                        request.auth.uid == request.resource.data.uploaderId);
      allow delete: if request.auth != null && request.auth.uid == resource.data.uploaderId;
      
      // Allow subcollection for comments
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null && request.auth.uid == resource.data.authorId;
        allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;
      }
    }

    // Admin panel data
    match /admin/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
